<nav style="border-bottom:thin solid #333;">
    <ul>
        {% for page in pages.children.visible %}
        {% set current_page = (page.active or page.activeChild) ? 'active' : '' %}
        <li class="">
            <a class="contrast {{ current_page|e }}" href="{{ page.url|e }}">
                {{ page.menu|e }}
            </a>
        </li>
        {% endfor %}
    </ul>
</nav>
