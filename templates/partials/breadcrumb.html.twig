{% macro loop(page) %}
    {% if page.parent is defined and page.parent.parent != null %}
    {{ _self.loop(page.parent) }}
    {% endif %}
    <li class=""><a href="{{ page.url }}">{{ page.menu }}</a></li>
{% endmacro %}

<nav aria-label="breadcrumb">
    <ul class="">
        {%- if page.parent is defined and page.parent.parent != null %}
        {{ _self.loop(page.parent) }}
        {%- endif %}
        <li class="" aria-current="page">{{ page.menu }}</li>
    </ul>
</nav>
