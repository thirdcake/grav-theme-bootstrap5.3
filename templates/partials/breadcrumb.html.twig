{% macro loop(page) %}
    {% if page.parent is defined and page.parent.parent != null %}
    {{ _self.loop(page.parent) }}
    {% endif %}
    <li class="breadcrumb-item"><a href="{{ page.url }}">{{ page.menu }}</a></li>
{% endmacro %}

<nav class="container" aria-label="breadcrumb">
    <ol class="breadcrumb py-2" style="--bs-breadcrumb-divider: '>';">
        {%- if page.parent is defined and page.parent.parent != null %}
        {{ _self.loop(page.parent) }}
        {%- endif %}
        <li class="breadcrumb-item active" aria-current="page">{{ page.menu }}</li>
    </ol>
</nav>
