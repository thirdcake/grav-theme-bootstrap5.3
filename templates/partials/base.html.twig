<!DOCTYPE html>
<html lang="ja">
<head>

{%- block head %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if header.title %}{{ header.title }} | {% endif %}{{ site.title }}</title>

    {% include 'partials/metadata.html.twig' %}
    <link rel="icon" type="image/png" href="{{ url('theme://images/logo.png')|e }}" />
    <link rel="canonical" href="{{ page.canonical(true)|e }}" />
{%- endblock %}

{% block stylesheets %}
    {% do assets.addCss('theme://css/bootstrap.min.css', 100) %}
    {% do assets.addCss('theme://css/custom.css', 99) %}
{% endblock %}

{% block javascripts %}
    {% do assets.addJs('theme://js/bootstrap.min.js', { priority: 100, loading: 'defer'}) %}
    {% do assets.addJs('theme://js/custom.js', { priority: 99, loading: 'defer'}) %}
{% endblock %}

{% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}

</head>
<body>

    <div class="">
        <header>
        {% block header %}{% endblock %}
        </header>

        <main>
        {%- block content %}{% endblock %}
        </main>

        <footer>
        {% block footer %}{% endblock %}
        </footer>
    </div>

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}

</body>
</html>
