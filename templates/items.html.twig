{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="markdown">
        <h1>{{ page.title }}</h1>
        {{- page.content|raw }}

        <ul>
        {%- for item in page.collection %}
            <li>
                <a href="{{ item.url }}">{{ item.title }}</a>
            </li>
        {%- endfor %}
        </ul>
    </div>
{% endblock %}
