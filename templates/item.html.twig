{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="markdown">
        <h1>{{ page.title }}</h1>
        {{- page.content|raw }}

        <div role="group">
            {%- if page.isLast %}
            <a href="#" role="button" disabled>&lt;</a>
            {%- else %}
            <a href="{{ page.prevSibling.url }}" role="button">&lt;{{ page.prevSibling.title}}</a>
            {%- endif %}
            
            <a href="{{ page.parent.url }}" role="button">^</a>

            {%- if page.isFirst %}
            <a href="#" role="button" disabled>&gt;</a>
            {%- else %}
            <a href="{{ page.nextSibling.url }}" role="button">{{ page.nextSibling.title}}&gt;</a>
        {%- endif %}
        
        </div>
    </div>
{% endblock %}
