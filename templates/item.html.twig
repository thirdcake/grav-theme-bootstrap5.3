{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="container markdown">
        <h1>{{ page.title }}</h1>
        {{- page.content|raw }}

        <div class="btn-group my-4">
            {%- if page.isLast %}
            <a href="#" class="btn btn-outline-secondary disabled">&lt;</a>
            {%- else %}
            <a href="{{ page.prevSibling.url }}" class="btn btn-outline-secondary">&lt;{{ page.prevSibling.title}}</a>
            {%- endif %}
            
            <a href="{{ page.parent.url }}" class="btn btn-outline-secondary">^</a>

            {%- if page.isFirst %}
            <a href="#" class="btn btn-outline-secondary disabled">&gt;</a>
            {%- else %}
            <a href="{{ page.nextSibling.url }}" class="btn btn-outline-secondary">{{ page.nextSibling.title}}&gt;</a>
        {%- endif %}
        
        </div>
    </div>
{% endblock %}
